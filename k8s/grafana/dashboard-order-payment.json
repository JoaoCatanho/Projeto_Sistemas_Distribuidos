      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "a72340b1-d871-4028-bbf1-1795e3553e62"
          },
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(rate(circuit_breaker_fallbacks_total{job=\"order\"}[$__rate_interval]))",
